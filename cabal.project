source-repository-package
  type: git
  location: https://github.com/colll78/cardano-config.git
  tag: e7a6f979964d2f613671832af001d06f99a67a86
  --sha256: sha256-D+PbL2GcvEwCpazxy8cYncl8EUjwuR4H5Wj2HWO3UX0=

source-repository-package
  type: git
  location: https://github.com/colll78/ouroboros-consensus.git
  tag: 0c91555c0c0dfeef6cb0ac6facd42b471630f5b0
  --sha256: sha256-19A5YUoKnfUAc/KBPg3s25HaI+zwMGiIk4Vng3NJXH4=

-- Dependency suites run in their owning repositories.
package *
  tests: False
  benchmarks: False

package cardano-api
  tests: True
  benchmarks: True

package cardano-api-gen
  tests: True

package cardano-rpc
  tests: True

package cardano-wasm
  tests: True
