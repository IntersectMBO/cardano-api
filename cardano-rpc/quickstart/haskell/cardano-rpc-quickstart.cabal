cabal-version: 3.0
name: cardano-rpc-quickstart
version: 0.1.0.0
build-type: Simple

executable cardano-rpc-quickstart
  main-is: Main.hs
  hs-source-dirs: app
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >=4 && <5,
    base16-bytestring,
    bytestring,
    cardano-rpc ^>=11.3,
    data-default-class,
    text,

executable send-lovelace
  main-is: SendLovelace.hs
  hs-source-dirs: app
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >=4 && <5,
    base16-bytestring,
    bytestring,
    cardano-api ^>=11.7,
    cardano-ledger-conway,
    cardano-ledger-core,
    cardano-rpc ^>=11.3,
    cardano-slotting,
    data-default-class,
    exceptions,
    text,
    time,
    unliftio,
